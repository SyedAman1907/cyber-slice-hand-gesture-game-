{
  "camera": {
    "device_index": 0,
    "width": 640,
    "height": 480,
    "fps": 30,
    "mirrored": true,
    "auto_reconnect": true
  },
  "detection": {
    "backend": "mediapipe",
    "max_num_hands": 2,
    "min_detection_confidence": 0.55,
    "min_tracking_confidence": 0.45,
    "yolo_model_path": "models/yolov8n-hand.pt",
    "yolo_confidence_threshold": 0.5,
    "draw_landmarks": true,
    "draw_bounding_box": true
  },
  "gestures": {
    "sensitivity": 1.0,
    "smoothing_factor": 0.5,
    "cooldown_seconds": 0.35,
    "swipe_history_len": 12,
    "swipe_min_distance": 0.18,
    "pinch_threshold": 0.055,
    "finger_curl_threshold": 0.12,
    "control_point": "index_tip",
    "one_euro_min_cutoff": 1.2,
    "one_euro_beta": 15.0,
    "tracking_loss_timeout": 0.22
  },
  "game": {
    "window_width": 1280,
    "window_height": 720,
    "target_fps": 60,
    "initial_lives": 3,
    "sound_enabled": true,
    "difficulty": "Medium",
    "blade_trail_length": 16,
    "countdown_seconds": 3,
    "action_mapping": {
      "Open Palm": "start_game",
      "Closed Fist": "stop_action",
      "Thumbs Up": "pause_resume",
      "Index Finger Pointing": "cursor_control",
      "Two-Finger Gesture": "secondary_action",
      "Pinch Gesture": "click_interact",
      "Swipe Left": "swipe_left_action",
      "Swipe Right": "swipe_right_action"
    },
    "slicing_mode": "motion"
  },
  "storage": {
    "stats_file": "data/game_stats.json"
  }
}